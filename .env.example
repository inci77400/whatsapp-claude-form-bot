# ============ ZORUNLU ============
# https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ============ MODEL ============
# claude-sonnet-5-5 hızlı ve uygun maliyetli; daha iyi cevap için claude-opus-5-5
CLAUDE_MODEL=claude-sonnet-5-5

# ============ MÜŞTERİ LİSTESİ ============
# Formu dolduranların listesi (örnek: ornek/musteriler.ornek.csv)
MUSTERI_CSV=veri/musteriler.csv
# İsteğe bağlı: Google Form cevap tablosunun "Web'de yayınla > CSV" linki (2 dakikada bir çekilir)
GOOGLE_SHEET_CSV_URL=
# Facebook/Instagram "Instant Form" ile gelen WhatsApp mesajının ilk cümlesi.
# Bu cümleyle başlayan mesajlar otomatik olarak form müşterisi sayılır.
FORM_MESAJI=Merhaba! Formunuzu doldurdum ve işletmeniz hakkında daha fazla bilgi edinmek istiyorum.

# ============ FACEBOOK LEAD ADS (isteğe bağlı) ============
# "Facebook Bagla.command" bunları sizin yerinize doldurur. Doluysa 2 saatte bir yeni başvurular çekilir.
META_ERISIM_TOKENI=
META_SAYFA_ID=

# ============ DAVRANIŞ ============
# Yeni başvurulara bot ilk mesajı kendiliğinden atsın mı? (evet / hayir)
# "hayir" ise panelden "İlk mesajları başlat" düğmesine basınca gönderir. İlk denemelerde "hayir" önerilir.
ILK_MESAJ_GONDER=hayir
# Toplu ilk mesajlar arasında kaç saniye beklensin (spam algılanmamak için)
ILK_MESAJ_ARALIK_SN=240
# İsteğe bağlı: veri/ilk-mesaj.txt içinde sadece geç cevaplarda kalması gereken cümle
GECIKME_CUMLESI=
# Müşteri art arda yazarsa kaç saniye bekleyip hepsine birden cevap versin
BEKLEME_SN=25
# Cevaptan önce "yazıyor..." gösterme süresi (saniye)
YAZMA_MIN_SN=4
YAZMA_MAX_SN=12
# Botun mesaj atabileceği saatler (İstanbul saati). Gece yarısını aşabilir: 09:00-05:00. Boş = 7/24
CALISMA_SAATLERI=09:00-23:00
# Bir müşteriye günde en fazla kaç bot cevabı
GUNLUK_LIMIT=30

# ============ TEKNİK ============
PANEL_PORT=3001
# Sistemde kurulu Chrome'u kullanmak için (başlatma betikleri Mac'te otomatik ayarlar)
CHROME_YOLU=
